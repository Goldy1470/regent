# ── Supabase (Project Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role — SERVER-ONLY. Never prefix with NEXT_PUBLIC_, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Dodo Payments ─────────────────────────────────────────────────
# test | live
DODO_MODE=test
DODO_API_KEY=
# standardwebhooks signing secret for /api/dodo/webhook.
# REQUIRED in production: the endpoint FAILS CLOSED (500) without it.
DODO_WEBHOOK_KEY=
# product IDs from the Dodo dashboard (Starter $29/mo & $290/yr, Growth $59/mo & $590/yr)
DODO_PRODUCT_STARTER=
DODO_PRODUCT_STARTER_ANNUAL=
DODO_PRODUCT_GROWTH=
DODO_PRODUCT_GROWTH_ANNUAL=

# ── AI (optional — the offline engine is the fallback) ────────────
OPENAI_API_KEY=

# ── App ───────────────────────────────────────────────────────────
# used for Dodo checkout/portal return URLs; set to the deployed origin in production
NEXT_PUBLIC_APP_URL=http://localhost:3000
