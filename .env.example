# Revenue Shield AI — environment
# Core (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# AI (optional — without it the app falls back to the built-in offline rule engine)
OPENAI_API_KEY=

# Dodo Payments (optional in demo — billing page shows setup hints without keys)
DODO_MODE=test
DODO_API_KEY=
DODO_WEBHOOK_KEY=
DODO_PRODUCT_STARTER=pdt_xxx
DODO_PRODUCT_SCALE=pdt_xxx
DODO_PRODUCT_PRO=pdt_xxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
